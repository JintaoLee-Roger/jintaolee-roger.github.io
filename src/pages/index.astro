---
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T.astro";
import PublicationItem from "../components/PublicationItem.astro";
import { getPublications, getSiteSettings } from "../lib/content";
import { getLastCommitDate } from "../lib/git";
import { cvDownloads } from "../lib/cv";

const settings = await getSiteSettings();
const publications = await getPublications();
const lastUpdated = getLastCommitDate(settings.lastUpdated);

const selectedPublicationMedia: Record<string, string> = {
  li2026sr_tip: "/images/pubs/tip25sr/tip25sr_s.png",
  li2026memory: "/images/pubs/ce25infer/ce25infer_s.png",
  li2025cigvis: "/images/pubs/geo24cigvis_s.png",
  li2023facies: "/images/pubs/geo23facies_s.png",
  li2022sr_tgrs: "/images/pubs/tgrs21sr_s.png",
};

const selectedSlugs = Object.keys(selectedPublicationMedia);
const selectedPublications = selectedSlugs
  .map((slug) => publications.find((publication) => publication.slug === slug))
  .filter((publication): publication is NonNullable<typeof publication> => Boolean(publication));

const news = [
  {
    date: "Aug. 2026",
    zh: "Jintao 获得国家自然科学基金委员会（NSFC）",
    en: "Jintao received funding from the National Natural Science Foundation of China (NSFC) through the ",
    highlight: {
      zh: "青年科学基金项目（C类）",
      en: "Young Scientists Fund (Category C)",
    },
    suffix: { zh: "资助。", en: "." },
  },
  {
    date: "Aug. 2026",
    zh: "Yuting Wang 关于地震反射系数估计的论文被 Geophysical Journal International 接收，我担任通讯作者。祝贺 Yuting！",
    en: "Yuting Wang's paper on seismic reflectivity estimation was accepted by Geophysical Journal International. I served as a corresponding author. Congratulations to Yuting!",
  },
  {
    date: "Jul. 2026",
    zh: "先后获得中国博士后科学基金第 79 批面上资助（2026M790497）和国家资助博士后研究人员计划 B 档资助（GZB20260111）。",
    en: "I received support from the China Postdoctoral Science Foundation 79th General Program (2026M790497) and the Postdoctoral Fellowship Program (Grade B) of China Postdoctoral Science Foundation (GZB20260111).",
  },
  {
    date: "Feb. 2026",
    zh: "高保真地震超分辨率论文被 IEEE Transactions on Image Processing 接收。",
    en: "Our high-fidelity seismic super-resolution paper was accepted by IEEE Transactions on Image Processing.",
  },
  {
    date: "Jan. 2026",
    zh: "大规模三维数据全体积推理工作被 Bioengineer.org 和 GeneOnline 报道。",
    en: "Our work on full-volume inference for large-scale 3D data was featured by Bioengineer.org and GeneOnline.",
  },
  {
    date: "Nov. 2025",
    zh: "内存高效三维推理论文被 Nature Portfolio 旗下 Communications Engineering 接收。",
    en: "Our memory-efficient 3D inference paper was accepted by Communications Engineering, part of Nature Portfolio.",
  },
  {
    date: "Sep. 2025",
    zh: "加入浙江大学开展博士后研究。",
    en: "I joined Zhejiang University as a postdoctoral researcher.",
  },
  {
    date: "May 2025",
    zh: "在中国科学技术大学通过地球物理学博士学位答辩。",
    en: "I successfully defended my PhD in Geophysics at the University of Science and Technology of China.",
  },
];
---

<BaseLayout title={`${settings.name.en} | AI4Geoscience`} description={settings.description.en} settings={settings}>
  <section class="home-intro" aria-labelledby="about-title">
    <p class="kicker"><T value={settings.role} /> · <T value={settings.affiliation} /></p>
    <h1 id="about-title"><span class="i18n i18n-zh">关于我</span><span class="i18n i18n-en">About Me</span></h1>
    <p class="home-updated" aria-label={`Site last updated ${lastUpdated}`}>
      <span><span class="i18n i18n-zh">网站更新</span><span class="i18n i18n-en">Site updated</span></span>
      <time datetime={lastUpdated}>{lastUpdated}</time>
    </p>
    <p class="intro-lede"><T value={settings.tagline} /></p>
    <div class="about-copy">
      <p>
        <span class="i18n i18n-zh">我目前在浙江大学从事博士后研究，与李伟昌教授合作。我于 2025 年在中国科学技术大学获得地球物理学博士学位，师从伍新明教授；此前于 2020 年在中国科大获得地球物理学学士学位。</span>
        <span class="i18n i18n-en">I am currently a postdoctoral researcher at Zhejiang University, working with Prof. Weichang Li. I received my PhD in Geophysics from the University of Science and Technology of China in 2025 under the supervision of Prof. Xinming Wu, after earning my BS in Geophysics from USTC in 2020.</span>
      </p>
      <p><T value={settings.description} /></p>
    </div>
    <div class="home-actions">
      <a class="button-link" href="/research/"><span class="i18n i18n-zh">查看研究</span><span class="i18n i18n-en">Explore research</span></a>
        <span class="i18n i18n-zh"><a class="text-link" href={cvDownloads.cn}>下载中文简历</a></span>
        <span class="i18n i18n-en"><a class="text-link" href={cvDownloads.en}>Download CV</a></span>
    </div>
  </section>

  <section class="home-section" aria-labelledby="interests-title">
    <div class="home-section-heading">
      <p class="section-number">01</p>
      <div>
        <p class="eyebrow"><span class="i18n i18n-zh">研究方向</span><span class="i18n i18n-en">Research</span></p>
        <h2 id="interests-title"><span class="i18n i18n-zh">研究兴趣</span><span class="i18n i18n-en">Research Interests</span></h2>
      </div>
    </div>
    <ul class="interest-list">
      {settings.keywords.map((keyword, index) => (
        <li><span>{String(index + 1).padStart(2, "0")}</span><T value={keyword} /></li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="news-title">
    <div class="home-section-heading">
      <p class="section-number">02</p>
      <div>
        <p class="eyebrow"><span class="i18n i18n-zh">最新动态</span><span class="i18n i18n-en">Updates</span></p>
        <h2 id="news-title"><span class="i18n i18n-zh">新闻</span><span class="i18n i18n-en">News</span></h2>
      </div>
    </div>
    <ol class="news-list" tabindex="0" aria-label="Scrollable news archive">
      {news.map((item, index) => (
        <li class:list={[index > 2 && "news-secondary"]}>
          <time>{item.date}</time>
          <p>
            <span class="i18n i18n-zh">{item.zh}{item.highlight && <strong>{item.highlight.zh}</strong>}{item.suffix?.zh}</span>
            <span class="i18n i18n-en">{item.en}{item.highlight && <strong>{item.highlight.en}</strong>}{item.suffix?.en}</span>
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section class="home-section" aria-labelledby="selected-publications-title">
    <div class="home-section-heading with-link">
      <p class="section-number">03</p>
      <div>
        <p class="eyebrow"><span class="i18n i18n-zh">代表性成果</span><span class="i18n i18n-en">Research Output</span></p>
        <h2 id="selected-publications-title"><span class="i18n i18n-zh">精选论文</span><span class="i18n i18n-en">Selected Publications</span></h2>
      </div>
      <a class="text-link" href="/publications/"><span class="i18n i18n-zh">全部论文</span><span class="i18n i18n-en">View all</span></a>
    </div>
    <div class="selected-publication-list">
      {selectedPublications.map((publication) => (
        <div class="selected-publication">
          <div class="selected-publication-media">
            <img src={selectedPublicationMedia[publication.slug]} alt="" loading="lazy" />
          </div>
          <PublicationItem publication={publication} compact />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
